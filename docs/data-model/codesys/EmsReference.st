(* Global Variable List named GVL_Ems. Export read-only; do not mark this GVL RETAIN. *)
{attribute 'qualified_only'}
VAR_GLOBAL
    Battery : ST_EmsAsset := (Id := 'BESS-01', Kind := 'battery-system');
