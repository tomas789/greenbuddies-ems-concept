{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical EMS telemetry frame v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "modelVersion": {
      "const": "1.0"
    },
    "configRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "producerId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": [
        "snapshot",
        "delta"
      ]
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "samples": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "quality": {
            "enum": [
              "good",
              "uncertain",
              "bad",
              "stale",
              "unsupported",
              "disabled",
              "initializing"
            ]
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "reason": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "value",
          "quality",
          "observedAt",
          "sequence"
        ]
      }
    }
  },
  "required": [
    "modelVersion",
    "configRevision",
    "producerId",
    "session",
    "sequence",
    "kind",
    "generatedAt",
    "samples"
  ]
}
